# 统一换行：仓库内文本用 LF，Windows 脚本用 CRLF
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Gradle wrapper 的 shell 脚本必须是 LF
gradlew        text eol=lf
gradlew.bat    text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.jar   binary
*.zip   binary

# 归档里的 jar 是发布产物，不做行尾/文本处理
versions/**/*.jar binary
