{
  "schemaVersion": 1,
  "id": "ctt-hud-fork",
  "version": "${version}",
  "name": "Cake Team Towers HUD - Fork",
  "description": "蛋糕塔 HUD - 分支版。为地图“蛋糕塔”（Cake Team Towers）制作：在敌人、玩家头顶显示血量条与相关信息，盾牌冷却指示器，以及可随时查看的属性面板；纯客户端可用，服务端选装。",
  "authors": [
    "nyaLium",
    "Fork of Cake-Hud (TheHolyLord/Cake-Hud, MIT, (c) Kirin0321)"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/nyaLium/Cake-Team_Towers-Hud-Lite",
    "sources": "https://github.com/nyaLium/Cake-Team_Towers-Hud-Lite",
    "issues": "https://github.com/nyaLium/Cake-Team_Towers-Hud-Lite/issues"
  },
  "icon": "assets/ctt-hud-fork/icon.png",
  "environment": "*",
  "mixins": [
    "ctt_hud_fork.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.nyalium.ctthudfork.CttHudForkServer"
    ],
    "client": [
      "com.nyalium.ctthudfork.CttHudForkClient"
    ],
    "modmenu": [
      "com.nyalium.ctthudfork.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  }
}
