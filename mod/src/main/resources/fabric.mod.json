{
  "schemaVersion": 1,
  "id": "ctt-hud-fork",
  "version": "${version}",
  "name": "CTT HUD - Fork",
  "description": "Fork of Cake-Hud (MIT): enemy / teammate health above name plates, plus a client-side stats panel (/trigger ViewStats) with per-attribute filtering.",
  "authors": [
    "nyaLium",
    "Fork of Cake-Hud (TheHolyLord/Cake-Hud, MIT, (c) Kirin0321)"
  ],
  "license": "MIT",
  "icon": "assets/ctt-hud-fork/icon.png",
  "environment": "*",
  "mixins": [
    "ctt_hud_fork.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.nyalium.ctthudfork.CttHudForkServer"
    ],
    "client": [
      "com.nyalium.ctthudfork.CttHudForkClient"
    ],
    "modmenu": [
      "com.nyalium.ctthudfork.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  }
}
