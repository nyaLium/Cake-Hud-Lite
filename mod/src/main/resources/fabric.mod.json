{
  "schemaVersion": 1,
  "id": "ctt-hud-fork",
  "version": "${version}",
  "name": "CTT HUD - Fork",
  "description": "为地图“蛋糕塔”（Cake Team Towers）制作！能在敌人、玩家的头顶显示血量条及相关信息；盾牌进入冷却时，会显示冷却指示器；能够随时查看属性的属性面板。",
  "authors": [
    "nyaLium",
    "Fork of Cake-Hud (TheHolyLord/Cake-Hud, MIT, (c) Kirin0321)"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/nyaLium/CTT-HUD-Mod-Fork-Version",
    "sources": "https://github.com/nyaLium/CTT-HUD-Mod-Fork-Version",
    "issues": "https://github.com/nyaLium/CTT-HUD-Mod-Fork-Version/issues"
  },
  "icon": "assets/ctt-hud-fork/icon.png",
  "environment": "*",
  "mixins": [
    "ctt_hud_fork.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.nyalium.ctthudfork.CttHudForkServer"
    ],
    "client": [
      "com.nyalium.ctthudfork.CttHudForkClient"
    ],
    "modmenu": [
      "com.nyalium.ctthudfork.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  }
}
